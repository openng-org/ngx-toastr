{
  "name": "ngx-toastr-site",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "demo:build": "ng build --configuration production --no-progress",
    "build": "ng-packagr -p projects/ngx-toastr/ng-package.json",
    "postbuild": "cpy README.md LICENSE dist/ngx-toastr",
    "test": "ng test --watch=false",
    "test:watch": "ng test --watch",
    "test:ci": "ng test --watch=false --no-progress --browsers=ChromeHeadlessCustom",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/openng-org/ngx-toastr"
  },
  "license": "MIT",
  "dependencies": {
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/router": "^22.1.1",
    "@ctrl/ngx-github-buttons": "^9.0.0",
    "bootstrap": "^5.3.8",
    "karma-coverage-istanbul-reporter": "^3.0.3",
    "lodash-es": "^4.18.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.1",
    "@eslint/js": "^10.0.1",
    "@types/jasmine": "~6.0.0",
    "@types/lodash-es": "^4.17.12",
    "angular-eslint": "22.1.0",
    "cpy-cli": "^7.0.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~6.3.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "ng-packagr": "^22.1.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.66.0"
  }
}
