{
  "name": "ngx-toastr-site",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "demo:build": "ng build --configuration production --no-progress",
    "build": "ng-packagr -p projects/ngx-toastr/ng-package.json",
    "postbuild": "cpy README.md LICENSE dist/ngx-toastr",
    "test": "ng test --watch=false",
    "test:watch": "ng test --watch",
    "test:ci": "ng test --watch=false",
    "test:peer": "node scripts/test-peer-compatibility.mjs",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix"
  },
  "private": true,
  "packageManager": "npm@11.7.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/openng-org/ngx-toastr"
  },
  "license": "MIT",
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@ctrl/ngx-github-buttons": "^9.0.0",
    "bootstrap": "^5.3.8",
    "lodash-es": "^4.17.22",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.3.0",
    "@angular/cli": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/lodash-es": "^4.17.12",
    "@vitest/coverage-v8": "^3.2.4",
    "angular-eslint": "20.7.0",
    "cpy-cli": "^6.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jsdom": "^30.0.1",
    "ng-packagr": "^20.3.0",
    "prettier": "^3.8.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.53.0",
    "vitest": "^3.2.4"
  }
